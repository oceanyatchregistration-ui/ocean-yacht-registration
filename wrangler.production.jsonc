{
  "name": "ocean-yacht-registration",
  "main": "server/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocean-yacht-registration-production",
      "database_id": "3c0c8472-fdc4-4b18-91a7-59f72a99e10d",
      "migrations_dir": "drizzle"
    }
  ],

  "routes": [
    { "pattern": "oceanyatchregistration.com", "custom_domain": true },
    { "pattern": "www.oceanyatchregistration.com", "custom_domain": true },
    { "pattern": "register.oceanyatchregistration.com", "custom_domain": true },
    { "pattern": "track.oceanyatchregistration.com", "custom_domain": true },
    { "pattern": "admin.oceanyatchregistration.com", "custom_domain": true }
  ],

  "vars": {
    "PUBLIC_ROOT_DOMAIN": "oceanyatchregistration.com",
    "ADMIN_EMAILS": "oceanyatchregistration@gmail.com",
    "SUPABASE_STORAGE_BUCKET": "registration-documents"
  },

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ]
}
