# Administrator allowlist (comma-separated). Configure in the hosting environment.
ADMIN_EMAILS=admin@example.com

# Admin login secrets. Configure both as hosting-platform secrets; never commit real values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Canonical production URL used in transactional email links.
APP_URL=https://oceanyachtregistration.com

# Transactional email (Resend). Keep RESEND_API_KEY in the platform secret store.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Ocean Yacht Registration <registrations@example.com>
EMAIL_REPLY_TO=support@example.com

# Private document storage (Supabase). Keep the secret key in the platform secret store.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=registration-documents
